# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Required only by the credentialed post-deployment smoke test.
ENERGYDEX_LIVE_BASE_URL=

# Test harness only. Never enable this in preview or production deployments.
ENERGYDEX_E2E=0
