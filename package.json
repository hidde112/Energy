{
  "name": "energydex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "db:start": "cross-env SUPABASE_INTERNAL_IMAGE_REGISTRY=ghcr.io SUPABASE_USE_SLIM_IMAGES=1 supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "cross-env SUPABASE_INTERNAL_IMAGE_REGISTRY=ghcr.io SUPABASE_USE_SLIM_IMAGES=1 supabase db reset",
    "test:db": "cross-env SUPABASE_INTERNAL_IMAGE_REGISTRY=ghcr.io supabase test db",
    "test:e2e": "playwright test",
    "test:smoke-live": "node scripts/smoke-live.ts",
    "verify:app": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "openai": "^7.30.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
